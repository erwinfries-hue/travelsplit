# Copy to .env.local and fill in. Only PUBLIC values belong here.
# Never put the service-role/secret key, database password or Google client secret in this file.

# Supabase project URL (local: http://127.0.0.1:54321)
VITE_SUPABASE_URL=
# Supabase publishable (anon) key – safe for the browser because every table is protected by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Show the local-only test login (never enable in production builds).
VITE_DEV_LOGIN=false
